              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "AUTH-01/AUTH-02/AUTH-05 — fan self-registration with email/password, terms acceptance required. Public, no token needed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Souza\",\n  \"email\": \"ana.souza@example.com\",\n  \"password\": \"SenhaForte123\",\n  \"birthdate\": \"1998-04-12\",\n  \"phone\": \"27999998888\",\n  \"terms_accepted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login (Fan)",
          "request": {
            "method": "POST",
            "header": [
