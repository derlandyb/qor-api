        {
          "name": "Verify Email (Fan)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/email/verify/:id/:hash",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "email",
                "verify",
                ":id",
                ":hash"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                },
                {
                  "key": "hash",
                  "value": "paste-signed-hash-from-email-link-here"
                }
              ]
            },
            "description": "AUTH-01 — signed email-verification link, clicked from the verification email; not called directly with a bearer token. `id` is the fan's user id, `hash` is the signed verification hash from the email link."
          },
          "response": []
