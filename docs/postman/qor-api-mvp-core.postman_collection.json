            "body": {
              "mode": "raw",
              "raw": "{\n  \"google_id\": \"108234567890123456789\",\n  \"email\": \"ana.souza@gmail.com\",\n  \"name\": \"Ana Souza\",\n  \"profile_picture_url\": \"https://lh3.googleusercontent.com/a/example\",\n  \"terms_accepted\": true\n}",
